PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/azharix
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_ORIGIN=http://localhost:3000

# Configure a real SMTP provider before sending OTPs.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="AZHARIX <no-reply@example.com>"
OTP_TTL_MINUTES=10


# Optional first admin bootstrap (keep real values only in local .env, never GitHub)
ADMIN_ID=CHANGE_ME_ADMIN_ID
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=AZHARIX Administrator
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
